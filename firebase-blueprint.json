{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "ArenaX player profile and account information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "Display name" },
        "handle": { "type": "string", "description": "Unique username handle" },
        "email": { "type": "string", "description": "User email address" },
        "av": { "type": "string", "description": "Avatar image URL" },
        "balance": { "type": "number", "description": "AX Coin balance" },
        "hasBlueTick": { "type": "boolean", "description": "Verified badge" },
        "premium": { "type": "boolean", "description": "VIP premium account status" },
        "isAXCreator": { "type": "boolean", "description": "Whether user is an approved AX Creator eligible to create teams" },
        "playerRole": { "type": "string", "enum": ["rusher", "sniper", "boomer", "supporter"], "description": "Esports combat specialization role" },
        "esportsRole": { "type": "string", "enum": ["none", "supporter"], "description": "Official Esports title role" },
        "supporterLevel": { "type": "number", "description": "Supporter level tier (1-4)" },
        "weeklyReward": { "type": "object", "description": "Player 7-day weekly reward progression and cooldown state" },
        "goldenWingsFrame": { "type": "object", "description": "Golden Wings Avatar Frame 72-Hour Free Trial state and permanent ownership" },
        "hasFrame": { "type": "boolean", "description": "Whether user owns or has active trial of an avatar frame" },
        "frameEquipped": { "type": "boolean", "description": "Whether user currently has avatar frame equipped" },
        "createdAt": { "type": "string", "description": "Account registration timestamp" }
      },
      "required": ["uid", "name", "handle", "balance"]
    },
    "RewardTransaction": {
      "title": "RewardTransaction",
      "description": "Daily and weekly reward claim history records",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Player UID" },
        "rewardType": { "type": "string", "description": "Type of reward (e.g. weekly_reward)" },
        "day": { "type": "number", "description": "Reward cycle day (1-7)" },
        "amount": { "type": "number", "description": "AX Coins awarded" },
        "isMystery": { "type": "boolean", "description": "Whether reward came from Day 7 Mystery Gift" },
        "cycleId": { "type": "string", "description": "Identifier of weekly reward cycle" },
        "claimedAt": { "type": "string", "description": "Timestamp of claim" }
      },
      "required": ["userId", "rewardType", "day", "amount"]
    },
    "RoleAuditRecord": {
      "title": "RoleAuditRecord",
      "description": "Administrative audit trail of player esports role and supporter level adjustments",
      "type": "object",
      "properties": {
        "targetUserId": { "type": "string", "description": "Target Player UID" },
        "previousRole": { "type": "string", "description": "Previous Esports Role" },
        "newRole": { "type": "string", "description": "Newly assigned Esports Role" },
        "previousLevel": { "type": "number", "description": "Previous Supporter Level" },
        "newLevel": { "type": "number", "description": "Newly assigned Supporter Level" },
        "adminUserId": { "type": "string", "description": "UID of admin making the modification" },
        "timestamp": { "type": "string", "description": "ISO timestamp of administrative action" }
      },
      "required": ["targetUserId", "newRole", "adminUserId", "timestamp"]
    },
    "Tournament": {
      "title": "Tournament",
      "description": "Mobile gaming tournament fixture",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Tournament title" },
        "game": { "type": "string", "description": "Game title (BGMI, Free Fire, etc)" },
        "entryFee": { "type": "number", "description": "Fee in AX Coins" },
        "prize": { "type": "string", "description": "Prize pool description" },
        "maxPlayers": { "type": "number", "description": "Max slot count" },
        "registered": { "type": "number", "description": "Registered player count" },
        "status": { "type": "string", "enum": ["upcoming", "ongoing", "completed"], "description": "Tournament status" }
      },
      "required": ["name", "game", "entryFee", "maxPlayers", "status"]
    },
    "DepositRequest": {
      "title": "DepositRequest",
      "description": "Fiat deposit transaction verification request",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Depositor UID" },
        "userName": { "type": "string", "description": "Depositor Name" },
        "amountPKR": { "type": "number", "description": "PKR amount deposited" },
        "coins": { "type": "number", "description": "Coins to credit" },
        "method": { "type": "string", "description": "JazzCash or EasyPaisa" },
        "txnId": { "type": "string", "description": "Payment Transaction ID" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"], "description": "Approval status" }
      },
      "required": ["userId", "amountPKR", "coins", "method", "txnId", "status"]
    },
    "ProfileReport": {
      "title": "ProfileReport",
      "description": "Player safety and moderation reports",
      "type": "object",
      "properties": {
        "reportedUid": { "type": "string", "description": "Reported user UID" },
        "reportedName": { "type": "string", "description": "Reported user name" },
        "reporterUid": { "type": "string", "description": "Reporting user UID" },
        "category": { "type": "string", "description": "Reason category" },
        "details": { "type": "string", "description": "Evidence / description" },
        "status": { "type": "string", "enum": ["pending", "reviewed", "actioned"], "description": "Moderation status" }
      },
      "required": ["reportedUid", "reporterUid", "category", "status"]
    },
    "ModerationHistory": {
      "title": "ModerationHistory",
      "description": "Admin actions, punishments, and warnings history log",
      "type": "object",
      "properties": {
        "targetUid": { "type": "string", "description": "Target player UID" },
        "actionType": { "type": "string", "description": "warning, restriction, temporary_block, permanent_ban, unblock" },
        "reason": { "type": "string", "description": "Reason for moderation action" },
        "adminUid": { "type": "string", "description": "Admin UID who executed action" },
        "adminName": { "type": "string", "description": "Admin display name" },
        "duration": { "type": "string", "description": "Duration if applicable" }
      },
      "required": ["targetUid", "actionType", "reason", "adminUid"]
    },
    "UserSession": {
      "title": "UserSession",
      "description": "Active and past logged-in sessions for account activity tracking",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "description": "Unique session identifier" },
        "userId": { "type": "string", "description": "User UID" },
        "deviceId": { "type": "string", "description": "Device hardware/fingerprint ID" },
        "deviceType": { "type": "string", "description": "desktop, mobile, tablet" },
        "platform": { "type": "string", "description": "OS/Platform (Windows, Android, iOS, etc)" },
        "browser": { "type": "string", "description": "Browser or app client" },
        "approximateLocation": { "type": "string", "description": "Approximate IP-derived city/region/country" },
        "ip": { "type": "string", "description": "Client IP address for security audit" },
        "createdAt": { "type": "number", "description": "Session creation timestamp" },
        "lastActiveAt": { "type": "number", "description": "Last activity timestamp" },
        "isRevoked": { "type": "boolean", "description": "Whether session has been remotely terminated" },
        "revokedAt": { "type": ["number", "null"], "description": "Revocation timestamp" }
      },
      "required": ["sessionId", "userId", "platform", "createdAt", "isRevoked"]
    },
    "KnownDevice": {
      "title": "KnownDevice",
      "description": "Recognized device record for smart new-device login detection",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string", "description": "Persistent device identifier" },
        "platform": { "type": "string", "description": "OS/Platform" },
        "browser": { "type": "string", "description": "Browser or app client" },
        "firstSeenAt": { "type": "number", "description": "First login timestamp" },
        "lastSeenAt": { "type": "number", "description": "Most recent login timestamp" },
        "approximateLocation": { "type": "string", "description": "Location where first seen" }
      },
      "required": ["deviceId", "platform", "firstSeenAt"]
    },
    "AccountActivity": {
      "title": "AccountActivity",
      "description": "Security audit events and login logs",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User UID" },
        "securityEventType": { "type": "string", "description": "NEW_DEVICE_LOGIN, REVOKED_SESSION, etc" },
        "sessionId": { "type": "string", "description": "Associated session ID" },
        "platform": { "type": "string", "description": "OS/Platform" },
        "browser": { "type": "string", "description": "Browser name" },
        "approximateLocation": { "type": "string", "description": "Approximate location" },
        "createdAt": { "type": "number", "description": "Event timestamp" }
      },
      "required": ["userId", "securityEventType", "createdAt"]
    },
    "AppVersionConfig": {
      "title": "AppVersionConfig",
      "description": "App version configuration for auto-update checks",
      "type": "object",
      "properties": {
        "latestVersion": { "type": "string", "description": "Latest release semver version (e.g. 1.1.0)" },
        "downloadUrl": { "type": "string", "description": "Direct APK download link" },
        "releaseNotes": { "type": "string", "description": "Summary of what's new in this release" },
        "mandatory": { "type": "boolean", "description": "Whether this update is mandatory" },
        "updatedAt": { "type": "string", "description": "Timestamp when release was published" }
      },
      "required": ["latestVersion", "downloadUrl"]
    },
    "AXCreatorRequest": {
      "title": "AXCreatorRequest",
      "description": "Application submitted by user requesting AX Creator team creation authorization",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Applicant user UID" },
        "name": { "type": "string", "description": "Applicant display name" },
        "handle": { "type": "string", "description": "Applicant username handle" },
        "av": { "type": "string", "description": "Applicant avatar URL" },
        "requestedAt": { "type": "string", "description": "Request creation timestamp" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"], "description": "Review status" },
        "reviewedAt": { "type": "string", "description": "Timestamp when admin took action" }
      },
      "required": ["uid", "name", "status"]
    }
  },
  "firestore": {
    "/ax_creator_requests/{reqId}": {
      "schema": "AXCreatorRequest",
      "description": "AX Creator approval requests for squad creation"
    },
    "/app_config/{configId}": {
      "schema": "AppVersionConfig",
      "description": "Application remote versioning and configuration"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles collection"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "UserSession",
      "description": "Logged-in device sessions for user"
    },
    "/users/{userId}/known_devices/{deviceId}": {
      "schema": "KnownDevice",
      "description": "Known recognized devices for user"
    },
    "/users/{userId}/account_activity/{activityId}": {
      "schema": "AccountActivity",
      "description": "Account activity security event logs"
    },
    "/tournaments/{tourId}": {
      "schema": "Tournament",
      "description": "Tournaments catalog"
    },
    "/deposit_requests/{reqId}": {
      "schema": "DepositRequest",
      "description": "Deposit requests submitted by players"
    },
    "/profile_reports/{reportId}": {
      "schema": "ProfileReport",
      "description": "Moderation profile reports"
    },
    "/moderation_history/{historyId}": {
      "schema": "ModerationHistory",
      "description": "Moderation punishment actions log"
    },
    "/reward_transactions/{txnId}": {
      "schema": "RewardTransaction",
      "description": "Weekly reward claims and transactions log"
    },
    "/role_audit_logs/{logId}": {
      "schema": "RoleAuditRecord",
      "description": "Administrative role modification audit records"
    }
  }
}
