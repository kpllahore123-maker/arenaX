{
  "headers": [
    {
      "source": "/api/golden-wings(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://arenax.cyou" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Requested-With, Accept" },
        { "key": "Access-Control-Max-Age", "value": "86400" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://arenax.cyou" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS, PATCH, DELETE, PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Requested-With, Accept" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/golden-wings/:action",
      "destination": "/api/golden-wings?action=:action"
    },
    {
      "source": "/api/admin/:action",
      "destination": "/api/admin?action=:action"
    },
    {
      "source": "/api/send-verification-code",
      "destination": "/api/email-verification?action=send"
    },
    {
      "source": "/api/verify-email-code",
      "destination": "/api/email-verification?action=verify"
    },
    {
      "source": "/api/request-password-reset",
      "destination": "/api/password-reset?action=request"
    },
    {
      "source": "/api/complete-password-reset",
      "destination": "/api/password-reset?action=complete"
    }
  ]
}
